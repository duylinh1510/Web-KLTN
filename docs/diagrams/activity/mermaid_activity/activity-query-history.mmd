%% Sơ đồ hoạt động - Query History theo implementation hiện tại
%% MongoDB lưu từ backend; frontend hiển thị lịch sử localStorage riêng.
flowchart LR
  classDef action fill:#ffffff,stroke:#334155,color:#0f172a;
  classDef decision fill:#fff7ed,stroke:#c2410c,color:#0f172a;
  classDef startEnd fill:#ecfdf5,stroke:#059669,color:#064e3b;
  classDef error fill:#fef2f2,stroke:#dc2626,color:#7f1d1d;
  classDef data fill:#eff6ff,stroke:#2563eb,color:#1e3a8a;
  classDef note fill:#fffbeb,stroke:#d97706,color:#78350f;

  subgraph U["Người dùng"]
    direction TB
    U0([Bắt đầu]):::startEnd
    U1["Gửi câu hỏi"]:::action
    U2["Mở lịch sử trên giao diện"]:::action
    U3["Chọn lại một query cũ"]:::action
    UZ([Kết thúc]):::startEnd
    U0 --> U1
    U2 --> U3 --> UZ
  end

  subgraph F["Giao diện Web"]
    direction TB
    F1["Nhận response /graph/query"]:::action
    F2{"Request thành công?"}:::decision
    F3["Lưu prompt, result, metadata<br/>vào localStorage query-history"]:::data
    F4["Lưu prompt và error<br/>vào localStorage query-history"]:::data
    F5["ChatHistory đọc entry<br/>từ localStorage"]:::action
    FN["Frontend hiện tại chưa gọi<br/>GET /history để đồng bộ MongoDB"]:::note
  end

  subgraph B["Backend NestJS"]
    direction TB
    B1["Xử lý Text2Cypher<br/>và execute Neo4j"]:::action
    B2{"Cypher đã execute<br/>thành công?"}:::decision
    B3["Gọi HistoryService.save()<br/>fire-and-forget"]:::action
    B4["Gọi HistoryService.save(error)<br/>fire-and-forget"]:::action
    B5["REST API đã có:<br/>GET /history, DELETE /history"]:::action
  end

  subgraph M["MongoDB"]
    direction TB
    M1["Insert queries document:<br/>prompt, cypher, result, metadata"]:::data
    M2["Insert queries document:<br/>prompt, cypher, error"]:::data
    M3["Collection queries<br/>giữ lịch sử server-side"]:::data
  end

  U1 --> B1 --> B2
  B2 -- "Có" --> B3 --> M1 --> M3
  B2 -- "Lỗi khi execute" --> B4 --> M2 --> M3
  B1 --> F1 --> F2
  F2 -- "Có" --> F3 --> U2
  F2 -- "Không" --> F4 --> U2
  U2 --> F5 --> FN
  B5 -. "Endpoint tồn tại" .-> M3
