%% Sơ đồ hoạt động - Text2Cypher query, schema linking, correction và execution
flowchart LR
  classDef action fill:#ffffff,stroke:#334155,color:#0f172a;
  classDef decision fill:#fff7ed,stroke:#c2410c,color:#0f172a;
  classDef startEnd fill:#ecfdf5,stroke:#059669,color:#064e3b;
  classDef error fill:#fef2f2,stroke:#dc2626,color:#7f1d1d;
  classDef data fill:#eff6ff,stroke:#2563eb,color:#1e3a8a;
  classDef ai fill:#f5f3ff,stroke:#7c3aed,color:#4c1d95;

  subgraph U["Người dùng"]
    direction TB
    U0([Bắt đầu]):::startEnd
    U1["Nhập câu hỏi tự nhiên"]:::action
    U2["Bấm Send"]:::action
    U3["Xem Cypher, bảng kết quả<br/>hoặc graph visualization"]:::action
    UE["Xem thông báo lỗi"]:::error
    UZ([Kết thúc]):::startEnd
    U0 --> U1 --> U2
    U3 --> UZ
    UE --> UZ
  end

  subgraph F["Giao diện Web"]
    direction TB
    F1["POST /graph/query"]:::action
    F2["Thêm entry thành công<br/>vào localStorage history"]:::action
    F3["Thêm entry lỗi<br/>vào localStorage history"]:::action
    F4["Render result"]:::action
    FE["Render lỗi"]:::error
  end

  subgraph B["Backend NestJS"]
    direction TB
    B1["Đếm tất cả node"]:::action
    B2{"Database rỗng?"}:::decision
    B3["Lấy full schema"]:::action
    B4{"Có schema cache<br/>trong dataset?"}:::decision
    B5["Schema linking:<br/>lọc schema theo Cypher V1<br/>(schema nhỏ giữ nguyên)"]:::action
    B6{"Cypher V2<br/>sinh thành công?"}:::decision
    B7["Read-only guard"]:::action
    B8{"Query read-only<br/>hợp lệ?"}:::decision
    B9["Gửi EXPLAIN"]:::action
    B10{"EXPLAIN pass?"}:::decision
    B11{"Đã thử tối đa<br/>3 lần?"}:::decision
    B12["Read-only guard lần cuối<br/>trước khi execute"]:::action
    B13["Format records thành<br/>graphData và scalars"]:::action
    BE["Trả response lỗi"]:::error
    BS["Trả response success"]:::action
  end

  subgraph A["Text2Cypher LLM"]
    direction TB
    A1["Generate V1<br/>với full schema"]:::ai
    A2["Generate V2<br/>với linked schema"]:::ai
    A3["Correct Cypher<br/>với error log và full schema"]:::ai
  end

  subgraph N["Neo4j"]
    direction TB
    N1["MATCH count nodes"]:::data
    N2["Đọc schema và sample values<br/>nếu cache miss"]:::data
    N3["EXPLAIN Cypher"]:::data
    N4["Thực thi Cypher<br/>bằng read session"]:::data
    N5{"Execution<br/>thành công?"}:::decision
  end

  subgraph M["MongoDB"]
    direction TB
    M1["Đọc datasets.graphSchema"]:::data
    M2["Lưu datasets.graphSchema"]:::data
    M3["Fire-and-forget:<br/>lưu query success vào queries"]:::data
    M4["Fire-and-forget:<br/>lưu lỗi execution vào queries"]:::data
  end

  U2 --> F1 --> B1 --> N1 --> B2
  B2 -- "Có" --> BE --> FE --> F3 --> UE
  B2 -- "Không" --> B3 --> M1 --> B4
  B4 -- "Không" --> N2 --> M2 --> A1
  B4 -- "Có" --> A1
  A1 --> B5 --> A2 --> B6
  B6 -- "Không" --> BE
  B6 -- "Có" --> B7 --> B8
  B8 -- "Không" --> BE
  B8 -- "Có" --> B9 --> N3 --> B10
  B10 -- "Không" --> B11
  B11 -- "Chưa" --> A3 --> B7
  B11 -- "Rồi" --> BE
  B10 -- "Có" --> B12 --> N4 --> N5
  N5 -- "Không" --> M4 --> BE
  N5 -- "Có" --> B13 --> M3 --> BS --> F2 --> F4 --> U3
  BE --> FE
