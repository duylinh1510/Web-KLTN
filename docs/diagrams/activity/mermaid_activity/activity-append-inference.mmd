%% Sơ đồ hoạt động - Append CSV và F-GNN Inference
%% Mermaid mô phỏng swimlane bằng các subgraph dọc trong luồng ngang.
flowchart LR
  classDef action fill:#ffffff,stroke:#334155,color:#0f172a;
  classDef decision fill:#fff7ed,stroke:#c2410c,color:#0f172a;
  classDef startEnd fill:#ecfdf5,stroke:#059669,color:#064e3b;
  classDef error fill:#fef2f2,stroke:#dc2626,color:#7f1d1d;
  classDef data fill:#eff6ff,stroke:#2563eb,color:#1e3a8a;
  classDef ai fill:#f5f3ff,stroke:#7c3aed,color:#4c1d95;

  subgraph U["Người dùng"]
    direction TB
    U0([Bắt đầu]):::startEnd
    U1["Upload CSV mới vào<br/>dataset đã có"]:::action
    U2["Bấm Append vào dataset"]:::action
    U3["Xem dữ liệu mới và số fraud<br/>nếu có inference"]:::action
    UE["Xem lỗi append"]:::error
    UZ([Kết thúc]):::startEnd
    U0 --> U1 --> U2
    U3 --> UZ
    UE --> UZ
  end

  subgraph F["Giao diện Web"]
    direction TB
    F1["Gửi POST /csv2graph/run"]:::action
    F2["Cập nhật dataset info<br/>và graph preview"]:::action
    FE["Hiển thị lỗi"]:::error
  end

  subgraph B["Backend NestJS"]
    direction TB
    B1["Tải canonical metadata"]:::action
    B2{"Metadata và graph<br/>hiện tại tồn tại?"}:::decision
    BF["Thực hiện luồng Full Build<br/>(xem diagram full build)"]:::action
    B3["Parse CSV append"]:::action
    B4{"Nhãn target bị thiếu<br/>một phần?"}:::decision
    B5{"Nhãn rỗng nhưng<br/>không có model?"}:::decision
    B6["Validate raw columns;<br/>bỏ cột thừa"]:::action
    B7{"Thiếu cột<br/>bắt buộc?"}:::decision
    B8["Ensure node_id bằng<br/>originalIdCol"]:::action
    B9{"Node ID bị trùng<br/>trong Neo4j?"}:::decision
    B10["Build star edges theo<br/>relation cols đã lưu"]:::action
    B11{"Cần inference?<br/>(model usable và chưa đủ nhãn)"}:::decision
    B12["Encode bằng schema và<br/>encoding maps cũ"]:::action
    B13["Gán nhãn dự đoán<br/>vào raw rows"]:::action
    B14["Dùng nhãn sẵn có hoặc<br/>ingest không inference"]:::action
    B15{"Có ingest<br/>vào Neo4j?"}:::decision
    BE["Trả lỗi validation"]:::error
  end

  subgraph A["Python / GNN Services"]
    direction TB
    A1["Sidecar tạo data.pt<br/>mode = inference"]:::ai
    A2["F-GNN dự đoán fraud"]:::ai
  end

  subgraph N["Neo4j"]
    direction TB
    N1["Đếm Transaction nodes"]:::data
    N2["Kiểm tra node_id trùng"]:::data
    N3["MERGE Transaction nodes"]:::data
    N4["MERGE AuxiliaryNodes và<br/>quan hệ heterogeneous"]:::data
  end

  subgraph M["MongoDB / File Job"]
    direction TB
    M1["Đọc datasets,<br/>pipeline_configs,<br/>encoding_maps"]:::data
    M2["Ghi nodes.csv,<br/>edges.csv, schema.json"]:::data
    M3["Ghi preprocessed.csv"]:::data
    M4["Dọn file trung gian;<br/>giữ data.pt và schema.json"]:::data
    M5["Lưu pipeline_runs<br/>mode = append"]:::data
  end

  U2 --> F1 --> B1 --> M1 --> N1 --> B2
  B2 -- "Không" --> BF --> UZ
  B2 -- "Có" --> B3 --> B4
  B4 -- "Có" --> BE --> FE --> UE
  B4 -- "Không" --> B5
  B5 -- "Có" --> BE
  B5 -- "Không" --> B6 --> B7
  B7 -- "Có" --> BE
  B7 -- "Không" --> B8 --> N2 --> B9
  B9 -- "Có" --> BE
  B9 -- "Không" --> B10 --> M2 --> B11
  B11 -- "Có" --> B12 --> M3 --> A1 --> A2 --> B13 --> B15
  B11 -- "Không" --> B14 --> B15
  B15 -- "Không" --> M4
  B15 -- "Có" --> N3 --> N4 --> M4
  M4 --> M5 --> F2 --> U3
