%% Sơ đồ hoạt động - Kết nối cơ sở dữ liệu Neo4j
%% Mermaid mô phỏng swimlane bằng các subgraph dọc.
flowchart LR
  classDef action fill:#ffffff,stroke:#334155,color:#0f172a;
  classDef decision fill:#fff7ed,stroke:#c2410c,color:#0f172a;
  classDef startEnd fill:#ecfdf5,stroke:#059669,color:#064e3b;
  classDef error fill:#fef2f2,stroke:#dc2626,color:#7f1d1d;
  classDef data fill:#eff6ff,stroke:#2563eb,color:#1e3a8a;

  subgraph U["Người dùng"]
    direction TB
    U0([Bắt đầu]):::startEnd
    U1["Nhập URI, user, password<br/>và Database Name"]:::action
    U2["Bấm Connect"]:::action
    U3["Nhận thông báo kết nối thành công"]:::action
    U4["Có thể build graph<br/>hoặc đặt câu hỏi"]:::action
    UE["Xem thông báo lỗi"]:::error
    UZ([Kết thúc]):::startEnd
    U0 --> U1 --> U2
    U3 --> U4 --> UZ
    UE --> UZ
  end

  subgraph F["Giao diện Web"]
    direction TB
    F1["POST /neo4j/connect"]:::action
    F2["Lưu trạng thái connection<br/>trong frontend store"]:::action
    FE["Hiển thị lỗi connect"]:::error
  end

  subgraph B["Backend NestJS"]
    direction TB
    B1["Tạo hoặc thay thế<br/>Neo4j driver"]:::action
    B2{"Credential và<br/>DBMS hợp lệ?"}:::decision
    B3["Lấy danh sách database online"]:::action
    B4{"Database được chọn<br/>có tồn tại?"}:::decision
    B5["Đặt currentDatabase"]:::action
    B6{"Database có node<br/>hiện hữu?"}:::decision
    B7{"Đã có graph schema<br/>cache?"}:::decision
    B8["Trả response success"]:::action
    BE["Trả response lỗi"]:::error
  end

  subgraph N["Neo4j"]
    direction TB
    N1["getServerInfo()"]:::data
    N2["SHOW DATABASES"]:::data
    N3["MATCH (n)<br/>RETURN count(n)"]:::data
  end

  subgraph M["MongoDB"]
    direction TB
    M1["Đọc datasets.graphSchema<br/>theo database"]:::data
    M2["Upsert connections<br/>(uri, database, lastUsedAt)"]:::data
  end

  U2 --> F1 --> B1 --> N1 --> B2
  B2 -- "Không" --> BE --> FE --> UE
  B2 -- "Có" --> B3 --> N2 --> B4
  B4 -- "Không" --> BE
  B4 -- "Có" --> B5 --> N3 --> B6
  B6 -- "Không, DB rỗng" --> M2
  B6 -- "Có" --> M1 --> B7
  B7 -- "Không" --> BE
  B7 -- "Có" --> M2
  M2 --> B8 --> F2 --> U3
