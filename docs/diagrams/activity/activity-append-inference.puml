@startuml activity_append_inference
title Sơ đồ hoạt động - Append CSV và F-GNN Inference

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BorderColor #111111
  BackgroundColor #FFFFFF
  FontColor #111111
}
skinparam activityDiamond {
  BorderColor #111111
  BackgroundColor #FFFFFF
}
skinparam swimlane {
  BorderColor #111111
  TitleBackgroundColor #FFFFFF
  TitleFontColor #111111
}

|Người dùng|
start
:Upload CSV mới vào\ndataset đã có;
:Bấm Append vào dataset;

|Giao diện Web|
:Gửi POST /csv2graph/run;

|Backend NestJS|
:Tải canonical metadata;

|MongoDB / File Job|
:Đọc datasets,\npipeline_configs,\nencoding_maps;

|Neo4j|
:Đếm Transaction nodes;

|Backend NestJS|
if (Metadata và graph hiện tại tồn tại?) then (Không)
  :Thực hiện luồng Full Build;
  stop
else (Có)
endif

:Parse CSV append;

if (Nhãn target bị thiếu một phần?) then (Có)
  :Trả lỗi validation;
  |Giao diện Web|
  :Hiển thị lỗi;
  |Người dùng|
  :Xem lỗi append;
  stop
else (Không)
endif

|Backend NestJS|
if (Nhãn rỗng nhưng không có model?) then (Có)
  :Trả lỗi validation;
  |Giao diện Web|
  :Hiển thị lỗi;
  |Người dùng|
  :Xem lỗi append;
  stop
else (Không)
endif

|Backend NestJS|
:Validate raw columns;\nbỏ cột thừa;

if (Thiếu cột bắt buộc?) then (Có)
  :Trả lỗi validation;
  |Giao diện Web|
  :Hiển thị lỗi;
  |Người dùng|
  :Xem lỗi append;
  stop
else (Không)
endif

|Backend NestJS|
:Ensure node_id bằng\noriginalIdCol;

|Neo4j|
:Kiểm tra node_id trùng;

|Backend NestJS|
if (Node ID bị trùng trong Neo4j?) then (Có)
  :Trả lỗi validation;
  |Giao diện Web|
  :Hiển thị lỗi;
  |Người dùng|
  :Xem lỗi append;
  stop
else (Không)
endif

|Backend NestJS|
:Build star edges theo\nrelation cols đã lưu;

|MongoDB / File Job|
:Ghi nodes.csv,\nedges.csv, schema.json;

|Backend NestJS|
if (Cần inference?\nModel usable và chưa đủ nhãn) then (Có)
  :Encode bằng schema và\nencoding maps cũ;
  |MongoDB / File Job|
  :Ghi preprocessed.csv;
  |Python / GNN Services|
  :Sidecar tạo data.pt\nmode = inference;
  :F-GNN dự đoán fraud;
  |Backend NestJS|
  :Gán nhãn dự đoán\nvào raw rows;
else (Không)
  :Dùng nhãn sẵn có hoặc\ningest không inference;
endif

|Backend NestJS|
if (Có ingest vào Neo4j?) then (Có)
  |Neo4j|
  :MERGE Transaction nodes;
  :MERGE AuxiliaryNodes và\nquan hệ heterogeneous;
else (Không)
endif

|MongoDB / File Job|
:Dọn file trung gian;\ngiữ data.pt và schema.json;
:Lưu pipeline_runs\nmode = append;

|Giao diện Web|
:Cập nhật dataset info\nvà graph preview;

|Người dùng|
:Xem dữ liệu mới và số fraud\nnếu có inference;
stop

@enduml
