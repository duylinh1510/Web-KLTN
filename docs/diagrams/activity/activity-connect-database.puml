@startuml activity_connect_database
title Sơ đồ hoạt động - Kết nối cơ sở dữ liệu Neo4j

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BorderColor #111111
  BackgroundColor #FFFFFF
  FontColor #111111
}
skinparam activityDiamond {
  BorderColor #111111
  BackgroundColor #FFFFFF
}
skinparam swimlane {
  BorderColor #111111
  TitleBackgroundColor #FFFFFF
  TitleFontColor #111111
}

|Người dùng|
start
:Nhập URI, username, password,\nvà Database Name;
:Bấm Connect;

|Giao diện Web|
:Gửi POST /neo4j/connect;

|Backend NestJS|
:Tạo hoặc thay thế\nNeo4j driver;

|Neo4j|
:Kiểm tra credential\nbằng getServerInfo();

|Backend NestJS|
if (Credential và DBMS hợp lệ?) then (Không)
  :Trả response lỗi;
  |Giao diện Web|
  :Hiển thị lỗi connect;
  |Người dùng|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Neo4j|
:Truy vấn SHOW DATABASES;

|Backend NestJS|
if (Database được chọn tồn tại?) then (Không)
  :Trả response lỗi;
  |Giao diện Web|
  :Hiển thị lỗi connect;
  |Người dùng|
  :Xem thông báo lỗi;
  stop
else (Có)
  :Đặt currentDatabase;
endif

|Neo4j|
:Đếm số node trong database;

|Backend NestJS|
if (Database có node hiện hữu?) then (Có)
  |MongoDB|
  :Đọc datasets.graphSchema\ntheo database;
  |Backend NestJS|
  if (Đã có graph schema cache?) then (Không)
    :Trả response lỗi\nthiếu graph schema cache;
    |Giao diện Web|
    :Hiển thị lỗi connect;
    |Người dùng|
    :Xem thông báo lỗi;
    stop
  else (Có)
  endif
else (Không, DB rỗng)
endif

|MongoDB|
:Upsert connections\n(uri, database, lastUsedAt);

|Backend NestJS|
:Trả response success;

|Giao diện Web|
:Lưu trạng thái connection\ntrong frontend store;

|Người dùng|
:Nhận thông báo kết nối thành công;
:Có thể build graph\nhoặc đặt câu hỏi;
stop

@enduml
