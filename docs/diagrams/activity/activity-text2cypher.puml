@startuml activity_text2cypher
title Sơ đồ hoạt động - Text2Cypher, schema linking, tự sửa lỗi và thực thi

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BorderColor #111111
  BackgroundColor #FFFFFF
  FontColor #111111
}
skinparam activityDiamond {
  BorderColor #111111
  BackgroundColor #FFFFFF
}
skinparam swimlane {
  BorderColor #111111
  TitleBackgroundColor #FFFFFF
  TitleFontColor #111111
}

|Người dùng|
start
:Nhập câu hỏi tự nhiên;
:Bấm Send;

|Giao diện Web|
:Gửi POST /graph/query;

|Backend NestJS|
:Đếm tất cả node;

|Neo4j|
:MATCH count nodes;

|Backend NestJS|
if (Database rỗng?) then (Có)
  :Trả response lỗi;
  |Giao diện Web|
  :Render lỗi và lưu entry lỗi\nvào localStorage history;
  |Người dùng|
  :Xem thông báo lỗi;
  stop
else (Không)
endif

|Backend NestJS|
:Lấy full schema;

|MongoDB|
:Đọc datasets.graphSchema;

|Backend NestJS|
if (Có schema cache trong dataset?) then (Không)
  |Neo4j|
  :Đọc schema và sample values;
  |MongoDB|
  :Lưu datasets.graphSchema;
else (Có)
endif

|Text2Cypher LLM|
:Generate Cypher V1\nvới full schema;

|Backend NestJS|
:Schema linking:\nlọc schema theo Cypher V1\n(schema nhỏ giữ nguyên);

|Text2Cypher LLM|
:Generate Cypher V2\nvới linked schema;

|Backend NestJS|
if (Cypher V2 sinh thành công?) then (Không)
  :Trả response lỗi;
  |Giao diện Web|
  :Render lỗi;
  |Người dùng|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Backend NestJS|
:Read-only guard;

if (Query read-only hợp lệ?) then (Không)
  :Trả response lỗi;
  |Giao diện Web|
  :Render lỗi;
  |Người dùng|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

repeat
  |Backend NestJS|
  :Gửi EXPLAIN;
  |Neo4j|
  :EXPLAIN Cypher;
  |Backend NestJS|
  if (EXPLAIN pass?) then (Không)
    |Text2Cypher LLM|
    :Correct Cypher\nvới error log và full schema;
    |Backend NestJS|
    :Read-only guard;
  else (Có)
  endif
repeat while (EXPLAIN lỗi và\nchưa đủ 3 lần?) is (Có)

|Backend NestJS|
if (EXPLAIN pass?) then (Không)
  :Trả response lỗi;
  |Giao diện Web|
  :Render lỗi;
  |Người dùng|
  :Xem thông báo lỗi;
  stop
else (Có)
endif

|Backend NestJS|
:Read-only guard lần cuối\ntrước khi execute;

|Neo4j|
:Thực thi Cypher\nbằng read session;

|Backend NestJS|
if (Execution thành công?) then (Không)
  |MongoDB|
  :Fire-and-forget:\nlưu lỗi execution vào queries;
  |Backend NestJS|
  :Trả response lỗi;
  |Giao diện Web|
  :Render lỗi;
  |Người dùng|
  :Xem thông báo lỗi;
  stop
else (Có)
  :Format records thành\ngraphData và scalars;
  |MongoDB|
  :Fire-and-forget:\nlưu query success vào queries;
  |Backend NestJS|
  :Trả response success;
  |Giao diện Web|
  :Lưu entry thành công\nvào localStorage history;
  :Render result;
  |Người dùng|
  :Xem Cypher, bảng kết quả\nhoặc graph visualization;
  stop
endif

@enduml
