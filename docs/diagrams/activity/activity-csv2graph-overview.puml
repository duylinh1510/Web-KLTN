@startuml activity_csv2graph_full_build
title Sơ đồ hoạt động - CSV2Graph Full Build / Train / Demo Model

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BorderColor #111111
  BackgroundColor #FFFFFF
  FontColor #111111
}
skinparam activityDiamond {
  BorderColor #111111
  BackgroundColor #FFFFFF
}
skinparam swimlane {
  BorderColor #111111
  TitleBackgroundColor #FFFFFF
  TitleFontColor #111111
}

|Người dùng|
start
:Chọn CSV đầu tiên;

|Giao diện Web|
:Gửi file để gợi ý\nTransaction ID;

|Backend NestJS|
:Parse CSV và lấy\nunique ID candidates;

|AI / Python Services|
:LLM gợi ý cột\nTransaction ID;

|Giao diện Web|
:Hiển thị cột ID gợi ý;

|Người dùng|
:Chọn Transaction ID,\nNode Label và chế độ build;
:Bấm Build Graph;

|Giao diện Web|
:Gửi POST /csv2graph/run\nmultipart form;

|Backend NestJS|
:Load metadata dataset;

|MongoDB / File Job|
:Đọc datasets và\npipeline_configs;

|Neo4j|
:Đếm Transaction nodes;

|Backend NestJS|
if (Đã có metadata và Transaction nodes?) then (Có)
  :Chuyển sang luồng\nAppend / Inference;
  |Giao diện Web|
  :Cập nhật dataset info\nvà graph preview;
  |Người dùng|
  :Xem thống kê dataset;
  stop
else (Không, full build)
endif

if (Vừa train model vừa demo model?) then (Có)
  :Trả lỗi dừng pipeline;
  |Giao diện Web|
  :Hiển thị response lỗi;
  |Người dùng|
  :Xem lỗi build;
  stop
else (Không)
endif

if (Chế độ cần nhãn targetLabel?) then (Train hoặc demo)
  if (CSV có cột target bắt buộc?) then (Không)
    :Trả lỗi dừng pipeline;
    |Giao diện Web|
    :Hiển thị response lỗi;
    |Người dùng|
    :Xem lỗi build;
    stop
  else (Có)
  endif
else (Ingest-only)
endif

|Backend NestJS|
:Parse rows và headers;

|AI / Python Services|
:LLM classify schema:\nnode_id, relation_cols, features;

|Backend NestJS|
:Ensure node_id theo\nlựa chọn hoặc LLM;

|MongoDB / File Job|
:Lưu rawColumns và originalIdCol\nvào pipeline_configs;

|Backend NestJS|
:Preprocess features:\nfloat / target-frequency encoding;
:Build star edges\ncho data.pt;

|MongoDB / File Job|
:Ghi nodes.csv, edges.csv,\nschema.json;

|Backend NestJS|
if (Có targetLabel?) then (Có)
  |MongoDB / File Job|
  :Ghi preprocessed.csv;
  |AI / Python Services|
  :Sidecar tạo data.pt\ntừ preprocessed.csv và edges.csv;
  |Backend NestJS|
  if (Train mode?) then (Có)
    |AI / Python Services|
    :Train F-GNN và cập nhật\nactive model;
  else (Không, demo)
    |AI / Python Services|
    :Dùng active demo model\n(không train lại);
  endif
else (Không)
endif

|Backend NestJS|
if (Có ingest vào Neo4j?) then (Có)
  |Neo4j|
  :Tạo constraints;
  :CREATE Transaction nodes;
  :MERGE AuxiliaryNodes và\nTransaction-to-Aux relationships;
  |MongoDB / File Job|
  :Lưu datasets, pipeline_configs\nvà encoding_maps;
else (Không)
endif

|Backend NestJS|
:Tập hợp kết quả job;

|MongoDB / File Job|
:Cleanup file trung gian;\ngiữ data.pt và schema.json;
:Lưu pipeline_runs\nmode = full;

|Giao diện Web|
:Refetch dataset info,\npreview và suggested prompts;

|Người dùng|
:Xem thống kê dataset\nvà graph preview;
stop

@enduml
